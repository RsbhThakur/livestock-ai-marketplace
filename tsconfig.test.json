{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["dom", "es2022"],
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "outDir": "./dist-test"
  },
  "include": ["src/lib/**/*.ts", "src/data/**/*.ts", "tests/**/*.ts"]
}
